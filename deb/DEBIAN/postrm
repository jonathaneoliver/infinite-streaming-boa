#!/bin/sh
# purge also drops boa's state: per-device policies, ladders and remembered
# channels. A plain remove keeps them for a reinstall.
set -e

case "$1" in
purge) rm -rf /var/lib/infinite-streaming-boa ;;
esac
[ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
exit 0
