# boa build configuration.
# Copy to .env and edit. Values are sourced by bash, so quote anything
# containing spaces or '#'.

## --- Access point -----------------------------------------------------
# Network name broadcast by the Pi (1-32 characters).
AP_SSID="infinite-streaming-boa"

# WPA2 passphrase for clients joining the AP (8-63 characters). This is the ONLY
# thing gating the network: the AP is a transparent bridge onto your existing
# LAN (no guest isolation), and the interface on :80 and ntopng on :3000 have no
# login -- so anyone who cracks a weak passphrase is on your real network AND can
# re-shape or black-hole any device on it. WPA2-PSK is crackable offline from one
# captured handshake, so use a strong, random passphrase.
AP_PASSWORD="change-me-please"

# Wireless regulatory domain. Must match where the Pi physically is,
# ISO 3166-1 alpha-2 (US, GB, DE, AU, ...). The radio stays rfkill-blocked
# until this is set, so a wrong/missing value means no AP at all.
AP_COUNTRY="US"

# bg = 2.4GHz (best range/compatibility), a = 5GHz (faster, shorter range).
AP_BAND="bg"

# Channel. 2.4GHz: 1, 6 or 11. 5GHz: 36, 40, 44 or 48 (non-DFS only --
# the Pi's onboard radio cannot act as an AP on DFS channels).
# Use 0 to let the driver choose.
AP_CHANNEL="6"

# The 2.4GHz channel the ONBOARD radio uses when a USB adapter is also fitted.
#
# With both radios present the box behaves like a dual-band router: the adapter
# takes 5GHz, where its 80MHz and 802.11ax are worth having, and the onboard
# chip takes 2.4GHz, where its 20MHz/802.11n ceiling costs nothing it could
# have delivered anyway. Both publish AP_SSID on one bridged segment, so a
# client sees one network and keeps its address moving between them.
#
# 1, 6 or 11 -- the only non-overlapping trio. Not 0: the onboard radio has no
# survey support, so automatic channel selection is impossible there.
#
# Ignored when the onboard radio is the only one, in which case it honours
# AP_BAND and AP_CHANNEL like anything else.
AP_CHANNEL_24="6"

# NOTE: boa is a TRANSPARENT BRIDGE. It hands out no addresses and does no
# NAT -- clients get their IPs from your existing router and stay on your
# existing subnet, and the Pi does not appear as a hop in traceroute.

# "true" to suppress SSID broadcast. Not a security measure.
AP_HIDDEN="false"

# Optional: a different SSID for the USB radio, when one is plugged in.
#
# Empty is right for normal use — both radios publish AP_SSID, so a client sees
# one network whichever radio is serving and roams between them without noticing
# an adapter being plugged or pulled.
#
# Set it while testing an adapter, to make it visible which radio a device
# actually joined — otherwise two APs with one name are indistinguishable from
# the client side, and "is it on the dongle?" is a guess. The cost is that it
# is then two networks rather than one, so a device will not roam between them.
#
# Clients on BOTH radios are conditioned: the daemon watches every radio that
# is serving, not just one.
AP_SSID_USB=""

## --- Bridge ports -----------------------------------------------------
# The port cabled to your existing network. Everything else downstream of the
# Pi reaches the internet through it, and it is where traffic conditioning is
# applied, so it must be correct.
BOA_WAN_PORT="eth0"

# A USB ethernet adapter is renamed to lan0 automatically and joins the bridge
# as a second downstream port. Wired clients on it are conditioned exactly like
# wireless ones -- policy is keyed by MAC, which both media have.

# Fixed rescue address on the bridge, always present alongside whatever the
# upstream DHCP server assigns. Without it, a headless box on a network with no
# DHCP server would be unreachable. Pick something off your normal subnet.
BOA_RESCUE_IP="192.168.99.1"

# Fixed MAC address for the bridge (br-lan). Leave EMPTY for the sensible
# default: boa pins br-lan to the WAN port's own burned-in MAC (the onboard NIC)
# at first boot -- globally unique per board, so two boxes on the same LAN never
# collide.
#
# Why this exists: a Linux bridge with no MAC set borrows the lowest MAC among
# its ports, so its identity would flip to whichever USB dongle is plugged in --
# and each hotplug (or a brownout on an underpowered supply) would change it,
# making the box's DHCP address unreachable from other machines until their ARP
# caches time out. Set an explicit value only if you need a specific MAC (e.g. a
# DHCP reservation on your router).
BOA_BRIDGE_MAC=""

## --- Device -----------------------------------------------------------
# Hostname, and the mDNS name: <BOA_HOSTNAME>.local
BOA_HOSTNAME="infinite-streaming-boa"

# Login account created on first boot.
BOA_USER="boa"

# Login password, for the PHYSICAL CONSOLE and for recovery. Setting a key
# below turns off password login over the network, so this is not what an
# attacker on the AP can try — but do change it from the default anyway.
#
# Leaving it empty locks the account with '*': no console login either, so a
# lost key then means reflashing the card. Setting both is the usable shape.
BOA_PASSWORD="raspberry"

# An SSH public key (the whole one-line "ssh-ed25519 AAAA... " string)
# authorised for BOA_USER. Set this.
#
# It is the credential the box's security actually rests on. With a key
# present the image disables SSH password authentication, which is what makes
# the passwordless sudo rule reasonable rather than reckless: getting a shell
# as BOA_USER already means owning the box, so a sudo prompt asking for the
# same short password twice buys nothing, while an unattended deploy over ssh
# cannot answer it at all.
#
# Without a key, sshd accepts BOA_PASSWORD from anyone associated to the AP,
# and those characters are the whole of the box's security. build.sh warns.
#
# SEVERAL keys may be given, one per line, and a spare on a second machine is
# worth having: with password login off, losing your only key leaves the
# physical console or a reflash. Blank lines, indentation and # comments are
# ignored, and build.sh parses every key with ssh-keygen and prints its
# fingerprint, so a truncated paste fails the build instead of the box.
#
#   BOA_SSH_PUBKEY="ssh-ed25519 AAAAC3Nz...primary laptop
#   ssh-ed25519 AAAAC3Nz...spare desktop"
BOA_SSH_PUBKEY=""

# ntopng's admin password, at http://<host>:3000/.
#
# ntopng ships here with login DISABLED (-l=1 in ntopng.conf), so nothing checks
# this: it is seeded only so the account is not left on ntopng's default should
# login ever be turned back on. A trivial value is fine and is the default.
#
# What matters is that it is not BOA_PASSWORD. Empty falls back to it, and
# ntopng stores its secret as an UNSALTED MD5 — a strictly weaker store than the
# SHA-512 crypt the system account uses — which would put your login password on
# the box in both forms. Keep the two apart.
BOA_NTOPNG_PASSWORD="password"

# Allow SSH password logins in addition to keys. Off by default: with it on,
# sshd accepts BOA_PASSWORD from anything associated to the AP, so the box is
# only as strong as those characters no matter how good your key is.
#
# Turn it on when you need a way in from a machine that has no key on it, and
# turn it back off afterwards. Requires BOA_PASSWORD to be set.
BOA_SSH_PASSWORD_LOGIN="false"

# Optional: e.g. "America/Denver". Empty keeps the image default (UTC).
BOA_TIMEZONE=""

## --- Power (Pi 5) ----------------------------------------------------
# Force the Pi 5 to allow its full 1.6A total USB current budget. Left off,
# the Pi 5 caps USB peripheral current to 600mA whenever it does not detect a
# 5V/5A supply -- enough to starve two dongles at once (a USB Wi-Fi radio plus
# a USB ethernet adapter), so one "stops working" when the other is plugged in,
# without ever tripping the undervoltage flag.
#
# "1" lifts the cap. Only do so with the official 27W (5A) PSU or a powered USB
# hub: on a supply that cannot actually deliver 1.6A this makes brownouts
# WORSE, not better. "0" (default) keeps the safe 600mA cap.
BOA_USB_MAX_CURRENT="0"

## --- Source image -----------------------------------------------------
# Leave empty to track the latest Raspberry Pi OS Lite (arm64), or pin a
# specific .img.xz URL for reproducible builds.
RPIOS_URL=""
