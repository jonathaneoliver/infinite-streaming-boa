# boa build configuration.
# Copy to .env and edit. Values are sourced by bash, so quote anything
# containing spaces or '#'.

## --- Access point -----------------------------------------------------
# Network name broadcast by the Pi (1-32 characters).
AP_SSID="infinite-streaming-boa"

# WPA2 passphrase for clients joining the AP (8-63 characters).
AP_PASSWORD="change-me-please"

# Wireless regulatory domain. Must match where the Pi physically is,
# ISO 3166-1 alpha-2 (US, GB, DE, AU, ...). The radio stays rfkill-blocked
# until this is set, so a wrong/missing value means no AP at all.
AP_COUNTRY="US"

# bg = 2.4GHz (best range/compatibility), a = 5GHz (faster, shorter range).
AP_BAND="bg"

# Channel. 2.4GHz: 1, 6 or 11. 5GHz: 36, 40, 44 or 48 (non-DFS only --
# the Pi's onboard radio cannot act as an AP on DFS channels).
# Use 0 to let the driver choose.
AP_CHANNEL="6"

# NOTE: boa is a TRANSPARENT BRIDGE. It hands out no addresses and does no
# NAT -- clients get their IPs from your existing router and stay on your
# existing subnet, and the Pi does not appear as a hop in traceroute.

# "true" to suppress SSID broadcast. Not a security measure.
AP_HIDDEN="false"

## --- Bridge ports -----------------------------------------------------
# The port cabled to your existing network. Everything else downstream of the
# Pi reaches the internet through it, and it is where traffic conditioning is
# applied, so it must be correct.
BOA_WAN_PORT="eth0"

# A USB ethernet adapter is renamed to lan0 automatically and joins the bridge
# as a second downstream port. Wired clients on it are conditioned exactly like
# wireless ones -- policy is keyed by MAC, which both media have.

# Fixed rescue address on the bridge, always present alongside whatever the
# upstream DHCP server assigns. Without it, a headless box on a network with no
# DHCP server would be unreachable. Pick something off your normal subnet.
BOA_RESCUE_IP="192.168.99.1"

## --- Device -----------------------------------------------------------
# Hostname, and the mDNS name: <BOA_HOSTNAME>.local
BOA_HOSTNAME="infinite-streaming-boa"

# Login account created on first boot.
BOA_USER="boa"

# Login password. May be left empty if BOA_SSH_PUBKEY is set, in which
# case password login is disabled entirely.
BOA_PASSWORD="raspberry"

# Optional: an SSH public key (the whole one-line "ssh-ed25519 AAAA... "
# string) authorised for BOA_USER. Strongly recommended.
BOA_SSH_PUBKEY=""

# Optional: e.g. "America/Denver". Empty keeps the image default (UTC).
BOA_TIMEZONE=""

## --- Source image -----------------------------------------------------
# Leave empty to track the latest Raspberry Pi OS Lite (arm64), or pin a
# specific .img.xz URL for reproducible builds.
RPIOS_URL=""
