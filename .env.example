# boa build configuration.
# Copy to .env and edit. Values are sourced by bash, so quote anything
# containing spaces or '#'.

## --- Access point -----------------------------------------------------
# Network name broadcast by the Pi (1-32 characters).
AP_SSID="infinite-streaming-boa"

# WPA2 passphrase for clients joining the AP (8-63 characters).
AP_PASSWORD="change-me-please"

# Wireless regulatory domain. Must match where the Pi physically is,
# ISO 3166-1 alpha-2 (US, GB, DE, AU, ...). The radio stays rfkill-blocked
# until this is set, so a wrong/missing value means no AP at all.
AP_COUNTRY="US"

# bg = 2.4GHz (best range/compatibility), a = 5GHz (faster, shorter range).
AP_BAND="bg"

# Channel. 2.4GHz: 1, 6 or 11. 5GHz: 36, 40, 44 or 48 (non-DFS only --
# the Pi's onboard radio cannot act as an AP on DFS channels).
# Use 0 to let the driver choose.
AP_CHANNEL="6"

# NOTE: boa is a TRANSPARENT BRIDGE. It hands out no addresses and does no
# NAT -- clients get their IPs from your existing router and stay on your
# existing subnet, and the Pi does not appear as a hop in traceroute.

# "true" to suppress SSID broadcast. Not a security measure.
AP_HIDDEN="false"

## --- Bridge ports -----------------------------------------------------
# The port cabled to your existing network. Everything else downstream of the
# Pi reaches the internet through it, and it is where traffic conditioning is
# applied, so it must be correct.
BOA_WAN_PORT="eth0"

# A USB ethernet adapter is renamed to lan0 automatically and joins the bridge
# as a second downstream port. Wired clients on it are conditioned exactly like
# wireless ones -- policy is keyed by MAC, which both media have.

# Fixed rescue address on the bridge, always present alongside whatever the
# upstream DHCP server assigns. Without it, a headless box on a network with no
# DHCP server would be unreachable. Pick something off your normal subnet.
BOA_RESCUE_IP="192.168.99.1"

## --- Device -----------------------------------------------------------
# Hostname, and the mDNS name: <BOA_HOSTNAME>.local
BOA_HOSTNAME="infinite-streaming-boa"

# Login account created on first boot.
BOA_USER="boa"

# Login password, for the PHYSICAL CONSOLE and for recovery. Setting a key
# below turns off password login over the network, so this is not what an
# attacker on the AP can try — but do change it from the default anyway.
#
# Leaving it empty locks the account with '*': no console login either, so a
# lost key then means reflashing the card. Setting both is the usable shape.
BOA_PASSWORD="raspberry"

# An SSH public key (the whole one-line "ssh-ed25519 AAAA... " string)
# authorised for BOA_USER. Set this.
#
# It is the credential the box's security actually rests on. With a key
# present the image disables SSH password authentication, which is what makes
# the passwordless sudo rule reasonable rather than reckless: getting a shell
# as BOA_USER already means owning the box, so a sudo prompt asking for the
# same short password twice buys nothing, while an unattended deploy over ssh
# cannot answer it at all.
#
# Without a key, sshd accepts BOA_PASSWORD from anyone associated to the AP,
# and those characters are the whole of the box's security. build.sh warns.
#
# SEVERAL keys may be given, one per line, and a spare on a second machine is
# worth having: with password login off, losing your only key leaves the
# physical console or a reflash. Blank lines, indentation and # comments are
# ignored, and build.sh parses every key with ssh-keygen and prints its
# fingerprint, so a truncated paste fails the build instead of the box.
#
#   BOA_SSH_PUBKEY="ssh-ed25519 AAAAC3Nz...primary laptop
#   ssh-ed25519 AAAAC3Nz...spare desktop"
BOA_SSH_PUBKEY=""

# Optional: ntopng's admin password, at http://<host>:3000/.
#
# Empty reuses BOA_PASSWORD. That works, but ntopng stores its admin secret as
# an UNSALTED MD5 digest, a strictly weaker store than the SHA-512 crypt the
# system account uses — so reusing the login password puts it on the box in
# both forms. Set this to keep the two apart.
BOA_NTOPNG_PASSWORD=""

# Optional: e.g. "America/Denver". Empty keeps the image default (UTC).
BOA_TIMEZONE=""

## --- Source image -----------------------------------------------------
# Leave empty to track the latest Raspberry Pi OS Lite (arm64), or pin a
# specific .img.xz URL for reproducible builds.
RPIOS_URL=""
