# Re-hands the adapters to the container every time it starts.
#
# A network namespace dies with its container, and the interfaces inside it
# return to the host when it does. So attaching is not a one-off: `docker
# restart`, a healthcheck restart, a host reboot -- each one needs the move done
# again, and without this unit the container would come up with an empty bridge
# and condition nothing.
#
# Restart=always rather than a timer: the watcher blocks on `docker events`, so
# the only reasons it exits are the docker daemon restarting or the socket going
# away, and both are exactly when it should come back.
[Unit]
Description=Attach physical adapters to the boa container
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
# SCAN_IF lives here, and it has to: the attach is run BY THIS UNIT rather than
# from a shell, so a variable set on a command line reaches nothing. Written
# every deploy by scripts/docker-deploy.sh from BOA_SCAN_IF in .env, the same
# way docker/.env carries the access point settings -- so the host cannot drift
# away from the checkout that deployed it.
#
# The leading '-' makes it optional. A host deployed before this existed has no
# such file, and a missing EnvironmentFile without the dash is a start failure
# -- which would take the adapters away from a working container to add a
# setting it is not using.
EnvironmentFile=-/etc/default/boa-attach
ExecStart=/usr/local/sbin/boa-attach-watch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
