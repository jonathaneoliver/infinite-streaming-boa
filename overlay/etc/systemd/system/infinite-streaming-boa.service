[Unit]
Description=infinite-streaming-boa per-client network link conditioner
Documentation=https://github.com/jonathaneoliver/infinite-streaming-boa
# The bridge must exist before queueing disciplines can be attached to its
# ports, and NetworkManager is what creates it.
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/infinite-streaming-boa
# -scan is written as ONE WORD with the '=' attached, which is why it needs no
# placeholder value the way BOA_LAN_PORT does. systemd replaces an empty ${VAR}
# with nothing, so the space-separated form "-scan ${BOA_SCAN_PORT}" would hand
# -scan the NEXT argument as its value; "-scan=" is a complete argument meaning
# "no listen-only radio", which is the default on every box.
#
# A comment cannot go inside the continued ExecStart below: the backslash makes
# those lines one value, and a '#' among them is parsed as part of the command.
ExecStart=/usr/local/bin/boad \
  -addr ${BOA_ADDR} \
  -bridge ${BOA_BRIDGE} \
  -wan ${BOA_WAN_PORT} \
  -wlan ${BOA_WLAN_PORT} \
  -lan ${BOA_LAN_PORT} \
  -scan=${BOA_SCAN_PORT} \
  -state ${BOA_STATE} \
  $BOA_EXTRA_ARGS
Restart=always
RestartSec=3

# Root is required: the daemon configures queueing disciplines and opens a
# packet socket to learn client addresses. These limits keep the rest of the
# system's surface closed rather than granting blanket privilege.
User=root
NoNewPrivileges=false
ProtectHome=yes
ProtectSystem=strict
# ProtectSystem=strict makes the WHOLE hierarchy read-only apart from /dev,
# /proc and /sys, so every writable path has to be named. Chart history goes to
# a RuntimeDirectory (tmpfs): it must survive a daemon restart, which happens on
# every deploy, but writing a time series to the SD card every few seconds is
# how a Pi appliance wears out its storage.
RuntimeDirectory=infinite-streaming-boa
RuntimeDirectoryPreserve=restart
ReadWritePaths=/var/lib/infinite-streaming-boa
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
